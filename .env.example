# Foundry project endpoint — auto-injected in hosted containers.
# Only set manually if running without `azd ai agent run`.
FOUNDRY_PROJECT_ENDPOINT=<your-foundry-endpoint-url>

# Model deployment name — must match a deployment in your Foundry project.
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4o

# API key for LOCAL development authentication.
# On Foundry hosted containers, leave this blank — Managed Identity is used automatically.
# Get your key from: Azure AI Foundry Portal → Your Project → Settings → API Keys
AZURE_AI_API_KEY=<your-azure-ai-api-key>

# ── Local telemetry suppression ───────────────────────────────────────
# Prevents the OpenTelemetry SDK from printing raw JSON span/metric blobs
# to the terminal when no Application Insights exporter is configured.
# Remove or override these in hosted Foundry environments.
OTEL_TRACES_EXPORTER=none
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none

# ── OTel resource detectors ───────────────────────────────────────────
# By default, Resource.create() runs ALL installed detectors, including
# azure_vm / azure_app_service / azure_functions which probe the Azure
# Instance Metadata Service (169.254.169.254). This IP only exists inside
# Azure VMs and causes a 200ms ConnectTimeout on local dev machines.
# Explicitly listing only non-cloud detectors suppresses those IMDS probes.
# In hosted Foundry containers, override this with:
#   OTEL_RESOURCE_DETECTORS=azure_app_service,azure_vm,otel,process,os
OTEL_RESOURCE_DETECTORS=otel,process,os

# ── Statsbeat / SDKStats — disable IMDS probing ───────────────────────
# The azure-monitor-opentelemetry-exporter statsbeat component
# (_StatsbeatMetrics._get_azure_compute_metadata) makes a direct
# requests.get() call to http://169.254.169.254/metadata/instance/compute
# to detect whether the app is running on an Azure VM. This is completely
# independent of the OTel resource detector mechanism above.
# Both env vars are checked: the legacy Azure Monitor one and the newer
# microsoft-opentelemetry distro one.
# Remove these in hosted Foundry environments where statsbeat is desired.
APPLICATIONINSIGHTS_STATSBEAT_DISABLED_ALL=true
MICROSOFT_OTEL_SDKSTATS_DISABLED=true

# Application Insights — auto-injected in hosted containers.
# Set for local telemetry (optional but recommended).
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...

# ── MCP Servers ───────────────────────────────────────────────────────
# ShopSense uses two MCP servers (container-compatible):
#   fetch  — scrapes live product prices and policies from the web
#   memory — (handled in-process by the agent; no external server needed)
#
# For Foundry container hosting, set this same value in agent.yaml
# under environment_variables so it is auto-injected at deployment.
# NOTE: Using Python-based servers only (npx/Node.js not available in container)
MCP_SERVERS_CONFIG={"servers":[{"id":"fetch","transport":"stdio","command":"python","args":["-m","mcp_server_fetch"]}]}
